  pp:showInGraph true ; pp:graphGroup "topic" ; pp:graphWeight 2 .

id:temporal-kgs a pp:Interest ;
  schema:name "Temporal knowledge graphs"@en, "Temporele kennisgrafen"@nl ;
  schema:description "Capturing how facts change over time in knowledge graphs built with LLMs."@en, "Vastleggen hoe feiten in de tijd veranderen in kennisgrafen die met LLM's gebouwd worden."@nl ;
  pp:showInGraph true ; pp:graphGroup "topic" ; pp:graphWeight 1 .

id:benchmarks a pp:Interest ;
  schema:name "Benchmarks and LLM evaluation"@en, "Benchmarks en LLM-evaluatie"@nl ;
