# --- Research topics. Sources: the existing paper nodes; manuscript folders 2025-llm-agent-kgc,
# 2027-vldb-rank-route-rerank and adhesives-table-annotation; HeritageKGBench README.
id:llm-kgc a pp:Interest ;
  schema:name "LLM-based KG construction"@en, "KG-constructie met LLM's"@nl ;
  schema:description "Turning text into knowledge graphs with language models, and finding out where that fails."@en, "Tekst omzetten in kennisgrafen met taalmodellen, en nagaan waar dat misloopt."@nl ;
  pp:showInGraph true ; pp:graphGroup "topic" ; pp:graphWeight 3 .

id:tables-to-kgs a pp:Interest ;
  schema:name "Tables to knowledge graphs"@en, "Van tabellen naar kennisgrafen"@nl ;
