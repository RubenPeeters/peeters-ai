---
import { ClientRouter } from 'astro:transitions';
import '~/styles/design/tokens.css';
import '~/styles/design/components.css';
import '~/styles/global.css';
import {
  t,
  pathFor,
  publishedNavRoutes,
  routes,
  type Locale,
  type RouteKey,
} from '~/i18n/strings';

type Props = {
  locale: Locale;
  routeKey: RouteKey;
  title?: string;
  description?: string;
  /*
    Chromeless layout hides the brand link, primary nav, and footer; the
    graph landing uses this so it can act as its own navigation. The lang
    switch stays, floating in the corner.
  */
  chromeless?: boolean;
};

const { locale, routeKey, title, description, chromeless = false } = Astro.props;
const s = t(locale);

const pageTitle = title ? `${title} | ${s.siteName}` : s.siteName;
const pageDescription = description ?? s.tagline;

const otherLocale: Locale = locale === 'en' ? 'nl' : 'en';
const otherHref = pathFor(routeKey, otherLocale);

const navKeys = publishedNavRoutes();

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const otherUrl = new URL(otherHref, Astro.site).href;
const ogImage = new URL('/og-image.svg', Astro.site).href;

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Ruben Peeters',
  jobTitle: 'PhD candidate',
  affiliation: { '@type': 'Organization', name: 'KU Leuven' },
  url: 'https://peeters.ai',
  email: 'mailto:ruben@fampeeters.be',
  sameAs: [
    'https://github.com/RubenPeeters',
    'https://scholar.google.com/citations?user=BRoMOlMAAAAJ',
  ],
};

const colourways: Partial<Record<RouteKey, string>> = {
  research: 'blue',
  cv: 'blue',
  projects: 'green',
  about: 'green',
  blog: 'orange',
  contact: 'orange',
};
const colourway = colourways[routeKey];

const skipToMainLabel = locale === 'nl' ? 'Spring naar inhoud' : 'Skip to content';
---
<!doctype html>
<html lang={locale}>
  <head>
    <script is:inline>
      // Runs before first paint so there is no flash; ClientRouter's swap replaces <html> attributes, so reapply after it.
      const applyTheme = () => {
        let theme = 'light';
        try {
          if (localStorage.getItem('theme') === 'dark') theme = 'dark';
        } catch {}
        document.documentElement.dataset.theme = theme;
      };
      applyTheme();
      document.addEventListener('astro:after-swap', applyTheme);
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#edf0e9" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bagel+Fat+One&family=Instrument+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={s.siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={locale === 'nl' ? 'nl_BE' : 'en_US'} />
    <meta property="og:locale:alternate" content={otherLocale === 'nl' ? 'nl_BE' : 'en_US'} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="alternate" hreflang={locale} href={canonicalUrl} />
    <link rel="alternate" hreflang={otherLocale} href={otherUrl} />
    <link rel="alternate" hreflang="x-default" href={new URL(pathFor(routeKey, 'en'), Astro.site).href} />


    <script is:inline type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />
    <ClientRouter />
  </head>
  <body class:list={[chromeless && 'is-chromeless']} data-colourway={colourway}>
    <a href="#main" class="skip-link">{skipToMainLabel}</a>

    {chromeless ? (
      <nav class="lang-switch floating" aria-label={s.langSwitch.label}>
        <a
          href={otherHref}
          hreflang={otherLocale}
          aria-label={`${s.langSwitch.label}: ${s.langSwitch[otherLocale]}`}
        >
          {s.langSwitch[otherLocale]}
        </a>
      </nav>
    ) : (
      <header class="site-header">
        <div class="container header-inner">
          <a href={pathFor('home', locale)} class="brand display-m">{s.siteName}</a>
          {navKeys.length > 0 && (
            <>
              <button
                type="button"
                class="btn btn-secondary menu-toggle"
                aria-expanded="false"
                aria-controls="site-nav"
                data-menu-toggle
              >
                {s.navigation.menu}
              </button>
              <nav class="site-nav" id="site-nav" aria-label={s.navigation.sections}>
                <ul>
                  {navKeys.map((key) => (
                    <li>
                      <a
                        href={pathFor(key, locale)}
                        aria-current={key === routeKey ? 'page' : undefined}
                      >
                        {routes[key].navLabel[locale]}
                      </a>
                    </li>
                  ))}
                </ul>
              </nav>
            </>
          )}
          <nav aria-label={s.langSwitch.label} class="lang-switch">
            {(['en', 'nl'] as const).map((l) =>
              l === locale ? (
                <span aria-current="true">{s.langSwitch[l]}</span>
              ) : (
                <a
                  href={otherHref}
                  hreflang={otherLocale}
                  aria-label={`${s.langSwitch.label}: ${s.langSwitch[otherLocale]}`}
                >
                  {s.langSwitch[l]}
                </a>
              )
            )}
          </nav>
          <div role="group" aria-label={s.themeSwitch.label} class="theme-switch">
            {(['light', 'dark'] as const).map((theme) => (
              <button type="button" data-theme-choice={theme} aria-pressed={theme === 'light' ? 'true' : 'false'}>
                {s.themeSwitch[theme]}
              </button>
            ))}
          </div>
        </div>
      </header>
    )}

    {!chromeless && <p class="container graph-return"><a href={pathFor('home', locale)}>&larr; {s.navigation.backToGraph}</a></p>}

    <main id="main">
      <slot />
    </main>

    {!chromeless && (
      <footer class="container site-footer">
        <p>
          {s.footer.builtWith}{' '}
          <a href="https://github.com/RubenPeeters/peeters-ai" class="ext">{s.footer.source}</a>.
        </p>
      </footer>
    )}

    <script>
      document.addEventListener('astro:page-load', () => {
        const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
        toggle?.addEventListener('click', () => {
          toggle.setAttribute('aria-expanded', String(toggle.getAttribute('aria-expanded') !== 'true'));
        });

        const choices = document.querySelectorAll<HTMLButtonElement>('[data-theme-choice]');
        const sync = () => choices.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.themeChoice === document.documentElement.dataset.theme)));
        sync();
        choices.forEach((b) => b.addEventListener('click', () => {
          document.documentElement.dataset.theme = b.dataset.themeChoice;
          try {
            localStorage.setItem('theme', b.dataset.themeChoice!);
          } catch {}
          sync();
        }));
      });
    </script>

    <style>
      .skip-link {
        position: absolute;
        top: var(--space-12);
        left: var(--space-12);
        padding: var(--space-8) var(--space-16);
        background: var(--color-text);
        color: var(--color-bg);
        border: none;
        font-family: var(--font-mono);
        font-size: var(--text-mono);
        letter-spacing: 0.06em;
        text-transform: uppercase;
        border-radius: 4px;
        transform: translateY(-200%);
        transition: transform var(--dur) var(--ease);
        z-index: 100;
      }
      .skip-link:focus-visible {
        transform: translateY(0);
        color: var(--color-bg);
      }

      .site-header { background: var(--surface); }
      .header-inner {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: var(--space-12) var(--space-16);
        padding-block: var(--space-12);
      }
      .brand { margin-right: auto; color: var(--text); text-decoration: none; border: none; }
      .graph-return { font-size: var(--text-small); margin-block: var(--space-16) 0; }
      .site-nav ul {
        display: flex;
        gap: var(--space-4);
        list-style: none;
        margin: 0;
        padding: 0;
      }
      .site-nav a,
      .site-header .lang-switch > *,
      .theme-switch > button {
        display: inline-block;
        font: 500 14px/20px var(--font-sans);
        color: var(--text);
        text-decoration: none;
        border: none;
        border-radius: var(--radius-pill);
      }
      .site-nav a { padding: 6px 14px; }
      .site-nav a:hover { background: var(--surface-sunken); }
      .site-nav a[aria-current='page'] { background: var(--btn); color: var(--on-btn); }
      .lang-switch { display: flex; }
      .site-header .lang-switch,
      .theme-switch {
        display: flex;
        padding: 2px;
        border-radius: var(--radius-pill);
        background: var(--surface-sunken);
      }
      .site-header .lang-switch > *,
      .theme-switch > button { padding: 4px 12px; }
      .theme-switch > button { background: none; cursor: pointer; }
      .site-header .lang-switch > [aria-current],
      .theme-switch > [aria-pressed='true'] { background: var(--btn); color: var(--on-btn); }
      .theme-switch > [aria-pressed='false']:hover { text-decoration: underline; }
      .site-header .lang-switch a:hover { color: var(--text); text-decoration: underline; }
      .menu-toggle { display: none; }
      .lang-switch.floating {
        position: fixed;
        top: var(--space-24);
        right: var(--space-24);
        z-index: 50;
        font-size: var(--text-small);
        letter-spacing: 0.06em;
        text-transform: uppercase;
      }
      .lang-switch.floating a {
        color: var(--color-text-muted);
        border-bottom: none;
        padding: var(--space-4) var(--space-8);
        transition: color var(--dur) var(--ease);
      }
      .lang-switch.floating a:hover {
        color: var(--color-text);
      }
      .site-footer {
        padding-block: var(--space-48) var(--space-32);
        color: var(--color-text-muted);
        font-size: var(--text-small);
        border-top: 1px solid var(--color-border);
        margin-top: var(--space-96);
      }
      .site-footer p { max-width: none; }

      @media (max-width: 640px) {
        .menu-toggle { display: inline-flex; }
        .site-nav { order: 3; flex-basis: 100%; }
        .site-nav ul { flex-direction: column; padding-bottom: var(--space-8); }
        .menu-toggle[aria-expanded='false'] ~ .site-nav { display: none; }
      }
    </style>
  </body>
</html>
