---
import { ClientRouter } from 'astro:transitions';
import '~/styles/design/tokens.css';
import '~/styles/design/components.css';
import '~/styles/global.css';
import {
  t,
  pathFor,
  publishedNavRoutes,
  routes,
  type Locale,
  type RouteKey,
} from '~/i18n/strings';

type Props = {
  locale: Locale;
  routeKey: RouteKey;
  title?: string;
  description?: string;
  /*
    Chromeless layout hides the brand link, primary nav, and footer; the
    graph landing uses this so it can act as its own navigation. The lang
    switch stays, floating in the corner.
  */
  chromeless?: boolean;
};

const { locale, routeKey, title, description, chromeless = false } = Astro.props;
const s = t(locale);

const pageTitle = title ? `${title} | ${s.siteName}` : s.siteName;
const pageDescription = description ?? s.tagline;

const otherLocale: Locale = locale === 'en' ? 'nl' : 'en';
const otherHref = pathFor(routeKey, otherLocale);

const navKeys = publishedNavRoutes();

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const otherUrl = new URL(otherHref, Astro.site).href;
const ogImage = new URL('/og-image.svg', Astro.site).href;

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Ruben Peeters',
  jobTitle: 'PhD candidate',
  affiliation: { '@type': 'Organization', name: 'KU Leuven' },
  url: 'https://peeters.ai',
  email: 'mailto:ruben@fampeeters.be',
  sameAs: [
    'https://github.com/RubenPeeters',
    'https://scholar.google.com/citations?user=BRoMOlMAAAAJ',
  ],
};

const colourways: Partial<Record<RouteKey, string>> = {
  research: 'blue',
  cv: 'blue',
  projects: 'green',
  about: 'green',
  blog: 'orange',
  contact: 'orange',
};
const colourway = colourways[routeKey];

// Each section's ink in the header, the same on every page and in both languages.
const navInks: Partial<Record<RouteKey, string>> = {
  blog: 'orange',
  research: 'blue',
  projects: 'lime',
  about: 'pink',
  cv: 'yellow',
  contact: 'teal',
};

const skipToMainLabel = locale === 'nl' ? 'Spring naar inhoud' : 'Skip to content';
---
<!doctype html>
<html lang={locale}>
  <head>
    <script is:inline>
      // Runs before first paint so there is no flash; ClientRouter's swap replaces <html> attributes, so reapply after it.
      const applyTheme = () => {
        let theme = 'light';
        try {
          if (localStorage.getItem('theme') === 'dark') theme = 'dark';
        } catch {}
        document.documentElement.dataset.theme = theme;
      };
      applyTheme();
      document.addEventListener('astro:after-swap', applyTheme);
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#ffffff" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bagel+Fat+One&family=Instrument+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={s.siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={locale === 'nl' ? 'nl_BE' : 'en_US'} />
    <meta property="og:locale:alternate" content={otherLocale === 'nl' ? 'nl_BE' : 'en_US'} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="alternate" hreflang={locale} href={canonicalUrl} />
    <link rel="alternate" hreflang={otherLocale} href={otherUrl} />
    <link rel="alternate" hreflang="x-default" href={new URL(pathFor(routeKey, 'en'), Astro.site).href} />


    <script is:inline type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />
    <ClientRouter />
  </head>
  <body class:list={[chromeless && 'is-chromeless']} data-colourway={colourway}>
    <a href="#main" class="skip-link">{skipToMainLabel}</a>

    {chromeless ? (
      <nav class="lang-switch floating" aria-label={s.langSwitch.label}>
        <a
          href={otherHref}
          hreflang={otherLocale}
          aria-label={`${s.langSwitch.label}: ${s.langSwitch[otherLocale]}`}
        >
          {s.langSwitch[otherLocale]}
        </a>
      </nav>
    ) : (
      <header class="site-header">
        <div class="container header-inner">
          <a href={pathFor('home', locale)} class="brand display-m">{s.siteName}</a>
          {navKeys.length > 0 && (
            <>
              <button
                type="button"
                class="btn btn-secondary menu-toggle"
                aria-expanded="false"
                aria-controls="site-nav"
                data-menu-toggle
              >
                {s.navigation.menu}
              </button>
              <nav class="site-nav" id="site-nav" aria-label={s.navigation.sections}>
                <ul>
                  {navKeys.map((key) => (
                    <li>
                      <a
                        href={pathFor(key, locale)}
                        aria-current={key === routeKey ? 'page' : undefined}
                        style={`--nav-ink: var(--ink-${navInks[key]})`}
                      >
                        {routes[key].navLabel[locale]}
                      </a>
                    </li>
                  ))}
                </ul>
              </nav>
            </>
          )}
          <a
            href={otherHref}
            class="lang-link"
            lang={otherLocale}
            hreflang={otherLocale}
            aria-label={s.langSwitch.names[otherLocale]}
          >
            {s.langSwitch[otherLocale]}
          </a>
          <button
            type="button"
            class="theme-toggle"
            aria-label={s.themeSwitch.toDark}
            data-to-dark={s.themeSwitch.toDark}
            data-to-light={s.themeSwitch.toLight}
            data-theme-toggle
          >
            <svg class="moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4 8 8 0 1 0 20 14.5Z" /></svg>
            <svg class="sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
          </button>
        </div>
      </header>
    )}

    {!chromeless && <p class="container graph-return"><a href={pathFor('home', locale)}>&larr; {s.navigation.backToGraph}</a></p>}

    <main id="main">
      <slot />
    </main>

    {!chromeless && (
      <footer class="container site-footer">
        <p>
          {s.footer.builtWith}{' '}
          <a href="https://github.com/RubenPeeters/peeters-ai" class="ext">{s.footer.source}</a>.
        </p>
      </footer>
    )}

    <script>
      document.addEventListener('astro:page-load', () => {
        const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
        toggle?.addEventListener('click', () => {
          toggle.setAttribute('aria-expanded', String(toggle.getAttribute('aria-expanded') !== 'true'));
        });

        const theme = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
        const sync = () => {
          if (!theme) return;
          const dark = document.documentElement.dataset.theme === 'dark';
          theme.setAttribute('aria-label', (dark ? theme.dataset.toLight : theme.dataset.toDark)!);
        };
        sync();
        theme?.addEventListener('click', () => {
          const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
          document.documentElement.dataset.theme = next;
          try {
            localStorage.setItem('theme', next);
          } catch {}
          sync();
        });
      });
    </script>

    <style>
      .skip-link {
        position: absolute;
        top: var(--space-12);
        left: var(--space-12);
        padding: var(--space-8) var(--space-16);
        background: var(--color-text);
        color: var(--color-bg);
        border: none;
        font-family: var(--font-mono);
        font-size: var(--text-mono);
        letter-spacing: 0.06em;
        text-transform: uppercase;
        border-radius: 4px;
        transform: translateY(-200%);
        transition: transform var(--dur) var(--ease);
        z-index: 100;
      }
      .skip-link:focus-visible {
        transform: translateY(0);
        color: var(--color-bg);
      }

      .site-header { background: var(--surface); }
      /* Wider than the reading measure so name, nav and the two controls share one line on desktop. */
      .header-inner {
        max-width: 64rem;
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: var(--space-12) var(--space-16);
        padding-block: var(--space-12);
      }
      .brand { margin-right: auto; color: var(--text); text-decoration: none; border: none; }
      .graph-return { font-size: var(--text-small); margin-block: var(--space-16) 0; }
      .site-nav ul {
        display: flex;
        gap: var(--space-4);
        list-style: none;
        margin: 0;
        padding: 0;
      }
      .site-nav a,
      .lang-link {
        display: inline-block;
        font: 500 14px/20px var(--font-sans);
        color: var(--text);
        text-decoration: none;
        border: none;
        border-radius: var(--radius-pill);
      }
      .site-nav a { padding: 6px 14px; }
      .site-nav a::before {
        content: '';
        display: inline-block;
        width: 9px;
        height: 9px;
        margin-right: 7px;
        box-sizing: border-box;
        border: 1.5px solid var(--line);
        border-radius: 50%;
        background: var(--nav-ink);
      }
      :global([data-theme='dark']) .site-nav a::before { border-color: var(--text); }
      .site-nav a:hover { background: var(--surface-sunken); }
      .site-nav a[aria-current='page'] { background: var(--nav-ink); color: var(--line); }
      .site-nav a[aria-current='page']::before { background: #fff; }
      .lang-link { padding: 8px 4px; }
      .lang-link:hover { color: var(--text); text-decoration: underline; }
      .theme-toggle {
        display: inline-grid;
        place-items: center;
        width: 36px;
        height: 36px;
        padding: 0;
        color: var(--text);
        background: none;
        border: none;
        border-radius: 50%;
        cursor: pointer;
      }
      .theme-toggle:hover { background: var(--surface-sunken); }
      .theme-toggle svg {
        width: 20px;
        height: 20px;
        fill: none;
        stroke: currentColor;
        stroke-width: 2;
        stroke-linecap: round;
        stroke-linejoin: round;
      }
      :global([data-theme='dark']) .theme-toggle .moon,
      :global(html:not([data-theme='dark'])) .theme-toggle .sun { display: none; }
      .menu-toggle { display: none; }
      .lang-switch.floating {
        position: fixed;
        top: var(--space-24);
        right: var(--space-24);
        z-index: 50;
        font-size: var(--text-small);
        letter-spacing: 0.06em;
        text-transform: uppercase;
      }
      .lang-switch.floating a {
        color: var(--color-text-muted);
        border-bottom: none;
        padding: var(--space-4) var(--space-8);
        transition: color var(--dur) var(--ease);
      }
      .lang-switch.floating a:hover {
        color: var(--color-text);
      }
      /* On wide screens it sits on the home graph's paper, which stays light in both themes. */
      @media (min-width: 901px) {
        .lang-switch.floating a,
        .lang-switch.floating a:hover { color: var(--line); }
      }
      .site-footer {
        padding-block: var(--space-48) var(--space-32);
        color: var(--color-text-muted);
        font-size: var(--text-small);
        border-top: 1px solid var(--color-border);
        margin-top: var(--space-96);
      }
      .site-footer p { max-width: none; }

      /* Below this the six sections, with their dots, no longer fit beside the name on one line. */
      @media (max-width: 1040px) {
        .menu-toggle { display: inline-flex; }
        .site-nav { order: 3; flex-basis: 100%; }
        .site-nav ul { flex-direction: column; padding-bottom: var(--space-8); }
        .menu-toggle[aria-expanded='false'] ~ .site-nav { display: none; }
      }
      /* Keeps name, Menu and both controls on one row down to 360 px phones. */
      @media (max-width: 480px) {
        .header-inner { column-gap: var(--space-8); }
        .brand { font-size: 22px; }
        .menu-toggle { padding-inline: 14px; }
      }
    </style>
  </body>
</html>
