---
import { getCollection } from 'astro:content';
import Print from '~/components/Print.astro';
import { t, type Locale } from '~/i18n/strings';

type Props = { locale: Locale };
const { locale } = Astro.props;
const s = t(locale).projects;

const projects = await getCollection('projects');
const sorted = [...projects].sort((a, b) => b.data.sortKey - a.data.sortKey);
const inks = ['ink0', 'ink1', 'ink2'];
---
<ol class="projects">
  {sorted.map((project, i) => {
    const { title, description, repo, demo, year, tags, progress } = project.data;
    return (
      <li class="card project bleed">
        <Print kind="superformula" arg={project.id} />
        <p class="meta">
          <span class="chip">{year}</span>
          {tags.map((tag) => <span class="chip chip-outline">{tag}</span>)}
        </p>
        <h3 class="title"><span class:list={['tile', inks[i % inks.length]]} aria-hidden="true"></span>{title}</h3>
        <p class="desc">{description[locale]}</p>
        {progress !== undefined && (
          <p class="progress">{s.progressLabel.replace('{n}', String(Math.round(progress * 100)))}</p>
        )}
        {(repo || demo) && (
          <p class="links">
            {repo && (
              <a href={repo} class="btn btn-secondary ext" rel="noopener">{s.labels.repo}</a>
            )}
            {demo && (
              <a href={demo} class="btn btn-secondary ext" rel="noopener">{s.labels.demo}</a>
            )}
          </p>
        )}
      </li>
    );
  })}
</ol>

<style>
  .projects {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-16);
  }
  .project {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }
  .project > :global(:not(.art)) { max-width: 70%; }
  .project > :global(.art) {
    width: 220px;
    height: 220px;
    right: -60px;
    bottom: -90px;
  }
  /* Below ~510px the art's visible 160 x 130 px corner reaches into the 70% text column, so it gets its own space. */
  @media (max-width: 640px) {
    .project { padding-bottom: 130px; }
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8);
    max-width: none;
  }
  .title {
    font-family: var(--font-sans);
    font-size: 1.375rem;
    line-height: 1.25;
    letter-spacing: -0.01em;
    font-weight: 500;
    margin: var(--space-4) 0 var(--space-4);
  }
  .tile {
    display: inline-block;
    width: 12px;
    height: 12px;
    margin-right: var(--space-8);
    border: 1.5px solid var(--line);
    border-radius: 3px;
    vertical-align: 0.05em;
  }
  .ink0 { background: var(--ink0); }
  .ink1 { background: var(--ink1); }
  .ink2 { background: var(--ink2); }
  .desc {
    color: var(--color-text);
    line-height: 1.5;
  }
  .progress {
    font-family: var(--font-mono);
    font-size: var(--text-mono);
    margin: 0;
  }
  .links {
    display: flex;
    gap: var(--space-8);
    margin: 0;
  }
</style>
