---
import { getCollection } from 'astro:content';
import Print from '~/components/Print.astro';
import { t, type Locale } from '~/i18n/strings';

type Props = { locale: Locale };
const { locale } = Astro.props;
const s = t(locale).projects;

const projects = await getCollection('projects');
const sorted = [...projects].sort((a, b) => b.data.sortKey - a.data.sortKey);
---
<ol class="projects">
  {sorted.map((project) => {
    const { title, description, repo, demo, year, tags, progress } = project.data;
    return (
      <li class="card project">
        {progress === undefined ? (
          <Print kind="superformula" arg={project.id} size="mark" />
        ) : (
          <Print kind="spiral" arg={progress} size="mark" label={s.progressLabel.replace('{n}', String(Math.round(progress * 100)))} />
        )}
        <p class="meta">
          <span class="chip">{year}</span>
          {tags.map((tag) => <span class="chip chip-outline">{tag}</span>)}
        </p>
        <h3 class="title">{title}</h3>
        <p class="desc">{description[locale]}</p>
        <p class="links">
          {repo && (
            <a href={repo} class="btn btn-secondary ext" rel="noopener">{s.labels.repo}</a>
          )}
          {demo && (
            <a href={demo} class="btn btn-secondary ext" rel="noopener">{s.labels.demo}</a>
          )}
        </p>
      </li>
    );
  })}
</ol>

<style>
  .projects {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
  }
  .project {
    display: grid;
    grid-template-columns: 1fr auto;
    column-gap: var(--space-16);
    row-gap: var(--space-8);
    align-content: start;
  }
  .project > :global(*) { grid-column: 1; }
  .project > :global(.art) { grid-column: 2; grid-row: 1 / span 3; }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8);
    max-width: none;
  }
  .title {
    font-family: var(--font-sans);
    font-size: 1.375rem;
    line-height: 1.25;
    letter-spacing: -0.01em;
    font-weight: 500;
    margin: var(--space-4) 0 var(--space-4);
  }
  .desc {
    color: var(--color-text);
  }
  .links {
    display: flex;
    gap: var(--space-8);
    margin: 0;
  }
</style>
