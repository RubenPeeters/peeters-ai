---
// Empty until /design/equation-art.js fills it, so pages without JavaScript show nothing.
type Props = {
  kind: 'rose' | 'lissajous' | 'hills' | 'sunflower' | 'superformula' | 'spiral';
  // sunflower: seed count; spiral: progress 0..1; superformula: seed string
  arg?: string | number;
  // bleed: the large header art (its .bleed parent places it); mark: the icon-size line mark for lists
  size?: 'bleed' | 'mark';
  // only for prints that carry a value; the rest are decorative
  label?: string;
};
const { kind, arg, size = 'bleed', label } = Astro.props;
---
<svg viewBox="0 0 240 240" class:list={['art', size === 'mark' && 'mark']} role={label ? 'img' : undefined} aria-label={label} aria-hidden={label ? undefined : 'true'} data-print={kind} data-arg={arg}></svg>

<script>
  type Art = Record<string, (svg: SVGSVGElement, arg?: unknown) => void> & {
    superParams: (seed: string) => unknown;
  };

  const lib = new Promise((resolve, reject) => {
    const script = document.createElement('script');
    script.src = '/design/equation-art.js';
    script.onload = resolve;
    script.onerror = reject;
    document.head.append(script);
  });

  const fill = () => {
    const art = (window as unknown as { PeetersArt: Art }).PeetersArt;
    document.querySelectorAll<SVGSVGElement>('svg[data-print]').forEach((svg) => {
      const { print = '', arg = '' } = svg.dataset;
      art[print](svg, print === 'superformula' ? art.superParams(arg) : Number(arg));
    });
  };

  // This module may first run after a client-side navigation, when astro:page-load has already fired.
  const run = () => lib.then(fill);
  run();
  document.addEventListener('astro:page-load', run);
</script>
