---
import Base from '~/layouts/Base.astro';
import PostList from '~/components/PostList.astro';
import SectionHeader from '~/components/SectionHeader.astro';
import { t } from '~/i18n/strings';

const locale = 'nl' as const;
const s = t(locale);
---
<Base locale={locale} routeKey="blog" title={s.blog.title} description={s.blog.intro}>
  <SectionHeader title={s.blog.title} intro={s.blog.intro} kind="rose" />
  <article class="container blog-index">
    <PostList locale={locale} />
  </article>

  <style>
    .blog-index {
      padding-block: var(--space-32) var(--space-96);
      display: flex;
      flex-direction: column;
      gap: var(--space-48);
    }
  </style>
</Base>
